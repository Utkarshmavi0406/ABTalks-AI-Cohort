# Dockerfile.frontend (at repo root)
# Streamlit frontend. Kept in a separate image from the backend so it
# doesn't drag in torch/chromadb/sentence-transformers -- it only needs
# streamlit, pandas, requests, and pydantic (for response_cards.py).

FROM python:3.12-slim AS builder

WORKDIR /build

COPY requirements-frontend.txt .
RUN pip install --no-cache-dir --user -r requirements-frontend.txt

FROM python:3.12-slim

WORKDIR /app

COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH

COPY app.py response_cards.py ./
COPY data/plans.csv ./data/plans.csv
COPY coverage.db ./

EXPOSE 8501

CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501"]
